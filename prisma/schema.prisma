// Prisma schema pro Skrytokraj — fáze 1
// Poznámky k rozhodnutím jsou v PROJECT.md (sekce "Rozhodnutí a poznámky").

generator client {
  // Prisma 7: nový generátor `prisma-client` (generuje TS klienta do repa).
  // Runtime vyžaduje driver adapter (@prisma/adapter-pg) — viz lib/prisma.ts.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7: connection URL se pro Migrate uvádí v prisma.config.ts,
  // runtime klient se připojuje přes adapter (viz lib/prisma.ts).
  provider = "postgresql"
  // PostGIS extension se zapíná v migraci (viz prisma/migrations) a přes
  // docker image postgis/postgis. Souřadnice ale zatím držíme jako Float
  // (lat/lng) — viz zdůvodnění v PROJECT.md.
}

// --- Role uživatele ---------------------------------------------------------
enum Role {
  admin
  user
}

// --- Typ bodu na mapě -------------------------------------------------------
enum MapPointType {
  quest // úkol (zakládá admin)
  treasure // poklad (zakládá admin)
  story_location // příběhové místo (zakládá admin)
  ar_location // AR místo (zakládá admin)
  message_box // schránka se vzkazem (zakládá i běžný uživatel)
}

// --- Viditelnost bodu -------------------------------------------------------
enum Visibility {
  public // vidí všichni přihlášení
  private_user // vidí jen konkrétní příjemce (recipient)
}

// --- Uživatel ---------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())

  // body, které uživatel založil
  createdPoints  MapPoint[] @relation("CreatedBy")
  // soukromé schránky určené tomuto uživateli
  receivedPoints MapPoint[] @relation("Recipient")
  // oblasti (kraje), které uživatel založil
  createdRegions Region[]   @relation("RegionCreatedBy")

  @@map("users")
}

// --- Bod na mapě ------------------------------------------------------------
// Jedna sdílená tabulka pro všechny typy bodů (viz PROJECT.md — proč ne
// oddělená tabulka MessageBox).
model MapPoint {
  id          String       @id @default(cuid())
  type        MapPointType
  name        String
  description String?      @db.Text // příběh / obsah bodu
  hint        String?      @db.Text // nápověda k nalezení (odděleně od příběhu)

  // Souřadnice (WGS84). PostGIS geometry sloupec se doplní později přes
  // raw SQL migraci, až budou potřeba prostorové dotazy.
  lat Float
  lng Float

  visibility Visibility @default(public)

  // Autor bodu
  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Příjemce soukromého bodu (visibility = private_user):
  //  - recipientId: existující uživatel
  //  - recipientEmail: pozvaný e-mail (příjemce zatím nemá účet); po registraci
  //    s tímto e-mailem bod uvidí (párování v getVisiblePoints)
  recipientId    String?
  recipient      User?   @relation("Recipient", fields: [recipientId], references: [id], onDelete: SetNull)
  recipientEmail String?

  // Placeholder pro budoucí AR obsah (identifikátor/odkaz na model)
  arContent String?

  // Oblast (kraj), do které bod patří — nepovinné (bod může být "globální").
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true) // deaktivace bez mazání
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([visibility])
  @@index([recipientId])
  @@index([recipientEmail])
  @@index([regionId])
  @@map("map_points")
}

// --- Oblast (kraj) ----------------------------------------------------------
// Univerzální šablona pro jeden kraj Skrytokraje (Petřvald, Průhonice, …).
// Přidává se průběžně, jak vznikají v realitě. Viz PROJECT.md.
model Region {
  id          String  @id @default(cuid())
  slug        String  @unique // pro adresu, např. "petrvald"
  name        String
  description String? @db.Text // úvod příběhu oblasti (kapitola kroniky)

  // Kam se mapa vycentruje při vstupu do kapitoly
  centerLat   Float
  centerLng   Float
  defaultZoom Float  @default(13)

  color       String? // akcentní barva oblasti (hex)
  isPublished Boolean @default(false) // ať jde kraj připravit skrytě

  createdById String
  createdBy   User   @relation("RegionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  points MapPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("regions")
}
